{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlutterKaigi/2026/packages/data/firebase/schemas/firestore/quiz_check_in_secret.schema.json",
  "title": "QuizCheckInSecret",
  "description": "Firestore document schema for `quizEvents/{eventId}/secret/checkIn` (venue check-in code, admin-only).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
