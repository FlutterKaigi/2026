{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlutterKaigi/2026/packages/data/firebase/schemas/firestore/quiz_admission_slot.schema.json",
  "title": "QuizAdmissionSlot",
  "description": "Server-only reservation at quizEvents/{eventId}/admissionSlots/{slot}, where slot is in [0, capacity).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid",
    "registeredAt"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "minLength": 1
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
