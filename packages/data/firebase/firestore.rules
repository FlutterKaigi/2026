rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 匿名認証ではない、実アカウントでサインインしているか。
    // クイズ大会は本人に紐づく記録を残すため、使い捨ての匿名 uid を排除する。
    function signedInWithAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasAdminAccess() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@flutterkaigi[.]jp$')
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // 参加者プロフィール。ドキュメント ID は Firebase Auth の uid。
    // プロフィール交換で他の参加者にも見せる前提のため、サインイン済みなら読める。
    // 書き込みは本人のみ。
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidSnsLink(link) {
      return link is map
        && link.keys().hasOnly(['type', 'value'])
        && link.type is string && link.type.size() > 0
        && link.value is string && link.value.size() > 0;
    }

    // packages/data/firebase/schemas/firestore/user_profile.schema.json と
    // UserProfile の上限値 (displayNameMaxLength / bioMaxLength /
    // snsLinksMaxCount) に合わせる。
    function isValidUserProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'avatarUrl', 'countryOrRegion', 'snsLinks', 'bio', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 30
        && (!('avatarUrl' in data) || data.avatarUrl == null
          || (data.avatarUrl is string && data.avatarUrl.matches('^https://.+')))
        && data.countryOrRegion is string && data.countryOrRegion.matches('^[A-Z]{2}$')
        && (!('snsLinks' in data)
          || (data.snsLinks is list && data.snsLinks.size() <= 10
            // rules は list の要素を反復できないため、先頭 10 件を個別に検証する。
            && (data.snsLinks.size() < 1 || isValidSnsLink(data.snsLinks[0]))
            && (data.snsLinks.size() < 2 || isValidSnsLink(data.snsLinks[1]))
            && (data.snsLinks.size() < 3 || isValidSnsLink(data.snsLinks[2]))
            && (data.snsLinks.size() < 4 || isValidSnsLink(data.snsLinks[3]))
            && (data.snsLinks.size() < 5 || isValidSnsLink(data.snsLinks[4]))
            && (data.snsLinks.size() < 6 || isValidSnsLink(data.snsLinks[5]))
            && (data.snsLinks.size() < 7 || isValidSnsLink(data.snsLinks[6]))
            && (data.snsLinks.size() < 8 || isValidSnsLink(data.snsLinks[7]))
            && (data.snsLinks.size() < 9 || isValidSnsLink(data.snsLinks[8]))
            && (data.snsLinks.size() < 10 || isValidSnsLink(data.snsLinks[9]))))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // packages/data/firebase/schemas/firestore/profile_exchange.schema.json と
    // ProfileExchange.noteMaxLength (200) に合わせる。
    function isValidExchangeNote(data) {
      return !('note' in data) || data.note == null
        || (data.note is string && data.note.size() <= 200);
    }

    // プロフィール交換の履歴。読み取った側が自分のサブコレクションに作成し、
    // 相手側は Cloud Functions のトリガーがミラーする（ここでは作成できない）。
    match /users/{uid}/exchanges/{otherUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && otherUid != uid
        && request.resource.data.keys().hasOnly(['createdAt', 'origin', 'token', 'note'])
        && request.resource.data.origin == 'scan'
        && request.resource.data.token is string
        && request.resource.data.createdAt == request.time
        && isValidExchangeNote(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
        && isValidExchangeNote(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /staffMembers/{staffMemberId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /timelineEvents/{timelineEventId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    function quizBeforeStart(eventId) {
      return get(/databases/$(database)/documents/quizEvents/$(eventId)).data.status
        in ['draft', 'published', 'registration', 'entryClosed'];
    }

    function quizQuestionContent(data) {
      return data.options is list && data.options.size() >= 2 && data.options.size() <= 4
        && data.durationSeconds is int && data.durationSeconds > 0 && data.durationSeconds <= 1800;
    }

    // Lifecycle, registration, membership and answers go through transactional
    // callables. Direct admin writes are limited to draft/configuration fields.
    match /quizEvents/{eventId} {
      allow get, list: if hasAdminAccess()
        || (signedInWithAccount() && resource.data.isPublic == true);
      allow create: if hasAdminAccess()
        && request.resource.data.keys().hasOnly([
          'title', 'status', 'isPublic', 'currentQuestionId', 'sponsorIds',
          'capacity', 'teamNamePool', 'createdAt', 'updatedAt', 'revision', 'participantCount'
        ])
        && request.resource.data.status == 'draft'
        && request.resource.data.isPublic == false
        && request.resource.data.get('currentQuestionId', null) == null
        && request.resource.data.get('participantCount', 0) == 0
        && request.resource.data.get('revision', 0) == 0
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 3 && request.resource.data.capacity <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasAdminAccess()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'sponsorIds', 'capacity', 'teamNamePool', 'updatedAt'
        ])
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 3 && request.resource.data.capacity <= 80
        && (request.resource.data.capacity == resource.data.capacity
          || (resource.data.status in ['draft', 'published']
            && resource.data.get('admissionSlotsReady', false) != true))
        && (resource.data.status in ['draft', 'published', 'registration', 'entryClosed']
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamNamePool', 'updatedAt']))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /secret/{secretId} {
        allow read: if hasAdminAccess();
        allow write: if false;
      }
      match /entryClaims/{uid} {
        allow read: if hasAdminAccess();
        allow write: if false;
      }
      match /entryAttempts/{uid} { allow read, write: if false; }
      match /admissionSlots/{slotId} { allow read, write: if false; }
      match /operations/{operationId} { allow read, write: if false; }
      match /participantAccounts/{uid} {
        allow get: if hasAdminAccess() || (signedInWithAccount() && request.auth.uid == uid);
        allow list: if hasAdminAccess();
        allow write: if false;
      }
      match /participants/{uid} {
        allow read: if hasAdminAccess() || signedInWithAccount();
        allow write: if false;
      }
      match /teams/{teamId} {
        allow read: if hasAdminAccess() || signedInWithAccount();
        allow update: if hasAdminAccess()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
        allow create, delete: if false;
      }
      match /questions/{questionId} {
        allow get: if hasAdminAccess() || (signedInWithAccount() && resource.data.status != 'draft');
        allow list: if hasAdminAccess();
        allow create: if hasAdminAccess() && quizBeforeStart(eventId)
          && request.resource.data.keys().hasOnly([
            'sponsorId', 'order', 'title', 'options', 'durationSeconds', 'status',
            'openedAt', 'closesAt', 'correctOptionIndex', 'explanation'
          ])
          && request.resource.data.status == 'draft'
          && request.resource.data.get('openedAt', null) == null
          && request.resource.data.get('closesAt', null) == null
          && request.resource.data.get('correctOptionIndex', null) == null
          && request.resource.data.get('explanation', null) == null
          && quizQuestionContent(request.resource.data);
        allow update: if hasAdminAccess() && quizBeforeStart(eventId)
          && resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sponsorId', 'order', 'title', 'options', 'durationSeconds'
          ]) && quizQuestionContent(request.resource.data);
        allow delete: if hasAdminAccess() && quizBeforeStart(eventId) && resource.data.status == 'draft';
        match /secret/{secretId} {
          allow read: if hasAdminAccess();
          allow create, update: if hasAdminAccess() && quizBeforeStart(eventId)
            && getAfter(/databases/$(database)/documents/quizEvents/$(eventId)/questions/$(questionId)).data.status == 'draft'
            && request.resource.data.keys().hasOnly(['correctOptionIndex', 'explanation'])
            && request.resource.data.correctOptionIndex is int
            && request.resource.data.correctOptionIndex >= 0
            && request.resource.data.correctOptionIndex < getAfter(/databases/$(database)/documents/quizEvents/$(eventId)/questions/$(questionId)).data.options.size();
          allow delete: if hasAdminAccess() && quizBeforeStart(eventId)
            && get(/databases/$(database)/documents/quizEvents/$(eventId)/questions/$(questionId)).data.status == 'draft';
        }
      }
      match /answers/{answerId} {
        allow get: if hasAdminAccess()
          || (signedInWithAccount() && request.auth.uid in get(/databases/$(database)/documents/quizEvents/$(eventId)/teams/$(resource.data.teamId)).data.memberUids);
        allow list: if hasAdminAccess();
        allow write: if false;
      }
    }
    match /quizParticipation/{uid} { allow read, write: if false; }

    // 写真の相手の分類と SNS 投稿 URL を自己申告で登録する。1人1件。
    // プロフィールの公開範囲とは分け、本人だけが参照・変更できる。
    // 登録には匿名認証ではなくアカウントでのサインインが必要。
    match /snsPostRegistrations/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['url', 'companion', 'updatedAt'])
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('^https?://[^/?#\\s@]+[.][^/?#\\s@]+/[^?#\\s][^\\s]*$')
        && request.resource.data.companion in ['staff', 'speaker', 'sponsor', 'firstTime', 'differentCountry']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // 応援 LT の共通認証コード（current）と全体の失敗回数（attempts）。
    // 管理者も callable 経由で発行・再発行する。
    // 参加者に read を許可するとコードによる参加確認が成立しなくなる。
    match /supportLtSettings/{settingId} {
      allow read: if hasAdminAccess();
      allow write: if false;
    }

    // 本人は登録済み状態を get できる。参加者一覧・人数の取得は管理者のみ。
    // 登録・削除は認証コード検証と Auth 削除トリガーが Admin SDK で行う。
    match /supportLtRegistrations/{uid} {
      allow get: if isOwner(uid) || hasAdminAccess();
      allow list: if hasAdminAccess();
      allow write: if false;
    }

    // registerSupportLt の総当たり対策。本人・管理者とも直接変更できない。
    match /supportLtRegistrationAttempts/{uid} {
      allow read, write: if false;
    }

    // 6桁コードのフォールバック交換で使う短命ドキュメント。issueExchangeCode /
    // redeemExchangeCode コールが Admin SDK 経由で読み書きする。read を許すと
    // 総当たりでコードを引き当てられるため、クライアントからは read/write とも
    // 一切許可しない。
    match /exchangeCodes/{code} {
      allow read, write: if false;
    }

    // redeemExchangeCode の失敗試行回数（ドキュメント ID は呼び出し元 uid）。
    // 同様に Function からのみ読み書きする。
    match /exchangeCodeAttempts/{uid} {
      allow read, write: if false;
    }

    // 集計値。website からの未認証 read を想定して公開し、更新は
    // Cloud Functions トリガーのみに限定する。
    match /counters/{counterId} {
      allow read: if true;
      allow write: if false;
    }

    // 未定義のパスを明示的に拒否（多層防御）。
    // Firestore はデフォルトで拒否するが、コレクション追加時の取りこぼしを防ぐため明示する。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
