rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAdminAccess() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@flutterkaigi[.]jp$')
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // 参加者プロフィール。ドキュメント ID は Firebase Auth の uid。
    // プロフィール交換で他の参加者にも見せる前提のため、サインイン済みなら読める。
    // 書き込みは本人のみ。
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidSnsLink(link) {
      return link is map
        && link.keys().hasOnly(['type', 'value'])
        && link.type is string && link.type.size() > 0
        && link.value is string && link.value.size() > 0;
    }

    // packages/data/firebase/schemas/firestore/user_profile.schema.json と
    // UserProfile の上限値 (displayNameMaxLength / bioMaxLength /
    // snsLinksMaxCount) に合わせる。
    function isValidUserProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'avatarUrl', 'countryOrRegion', 'snsLinks', 'bio', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 30
        && (!('avatarUrl' in data) || data.avatarUrl == null
          || (data.avatarUrl is string && data.avatarUrl.matches('^https://.+')))
        && data.countryOrRegion is string && data.countryOrRegion.matches('^[A-Z]{2}$')
        && (!('snsLinks' in data)
          || (data.snsLinks is list && data.snsLinks.size() <= 10
            // rules は list の要素を反復できないため、先頭 10 件を個別に検証する。
            && (data.snsLinks.size() < 1 || isValidSnsLink(data.snsLinks[0]))
            && (data.snsLinks.size() < 2 || isValidSnsLink(data.snsLinks[1]))
            && (data.snsLinks.size() < 3 || isValidSnsLink(data.snsLinks[2]))
            && (data.snsLinks.size() < 4 || isValidSnsLink(data.snsLinks[3]))
            && (data.snsLinks.size() < 5 || isValidSnsLink(data.snsLinks[4]))
            && (data.snsLinks.size() < 6 || isValidSnsLink(data.snsLinks[5]))
            && (data.snsLinks.size() < 7 || isValidSnsLink(data.snsLinks[6]))
            && (data.snsLinks.size() < 8 || isValidSnsLink(data.snsLinks[7]))
            && (data.snsLinks.size() < 9 || isValidSnsLink(data.snsLinks[8]))
            && (data.snsLinks.size() < 10 || isValidSnsLink(data.snsLinks[9]))))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);

      // プロフィール交換の記録。ドキュメント ID は相手の uid。
      // 自分がスキャンした側だけが自分のリストに作成でき（origin: 'scan'）、
      // 相手側のミラー（origin: 'mirror'）は Cloud Functions トリガーが作成する
      // （Admin SDK は Firestore ルールの対象外）。
      //
      // packages/data/firebase/schemas/firestore/profile_exchange.schema.json と
      // ProfileExchange の上限値 (noteMaxLength) に合わせる。
      // isValidProfileExchange（create 時）と exchanges の update ルールの両方から
      // 呼ぶので、上限値の変更箇所を 1 箇所にまとめておく。
      function isValidNote(data) {
        return !('note' in data) || data.note == null
          || (data.note is string && data.note.size() <= 300);
      }

      function isValidProfileExchange(data) {
        return data.keys().hasOnly(['createdAt', 'origin', 'token', 'note'])
          && data.createdAt is timestamp
          && data.origin in ['scan', 'mirror']
          && (!('token' in data) || data.token == null || data.token is string)
          && isValidNote(data);
      }

      match /exchanges/{otherUid} {
        allow read: if isOwner(uid);
        // 読み取った側が自分のリストにだけ作成できる。相手側はトリガーがミラーする。
        allow create: if isOwner(uid)
          && otherUid != uid
          && isValidProfileExchange(request.resource.data)
          && request.resource.data.origin == 'scan'
          && request.resource.data.token is string
          && request.resource.data.createdAt == request.time;
        // 自分専用メモの更新のみを許可する。トークンの検証・null 化やミラー作成は
        // Cloud Functions（Admin SDK）が行うため、クライアントの update では扱わない。
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
          && isValidNote(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // プロフィール交換数などの集計値。書き込みは Cloud Functions（Admin SDK）のみ。
    // website から未認証で参照するため read は公開する。
    match /counters/{counterId} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /staffMembers/{staffMemberId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /timelineEvents/{timelineEventId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    // 未定義のパスを明示的に拒否（多層防御）。
    // Firestore はデフォルトで拒否するが、コレクション追加時の取りこぼしを防ぐため明示する。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
