rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 匿名認証ではない、実アカウントでサインインしているか。
    // クイズ大会は本人に紐づく記録を残すため、使い捨ての匿名 uid を排除する。
    function signedInWithAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasAdminAccess() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@flutterkaigi[.]jp$')
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // 参加者プロフィール。ドキュメント ID は Firebase Auth の uid。
    // プロフィール交換で他の参加者にも見せる前提のため、サインイン済みなら読める。
    // 書き込みは本人のみ。
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidSnsLink(link) {
      return link is map
        && link.keys().hasOnly(['type', 'value'])
        && link.type is string && link.type.size() > 0
        && link.value is string && link.value.size() > 0;
    }

    // packages/data/firebase/schemas/firestore/user_profile.schema.json と
    // UserProfile の上限値 (displayNameMaxLength / bioMaxLength /
    // snsLinksMaxCount) に合わせる。
    function isValidUserProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'avatarUrl', 'countryOrRegion', 'snsLinks', 'bio', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 30
        && (!('avatarUrl' in data) || data.avatarUrl == null
          || (data.avatarUrl is string && data.avatarUrl.matches('^https://.+')))
        && data.countryOrRegion is string && data.countryOrRegion.matches('^[A-Z]{2}$')
        && (!('snsLinks' in data)
          || (data.snsLinks is list && data.snsLinks.size() <= 10
            // rules は list の要素を反復できないため、先頭 10 件を個別に検証する。
            && (data.snsLinks.size() < 1 || isValidSnsLink(data.snsLinks[0]))
            && (data.snsLinks.size() < 2 || isValidSnsLink(data.snsLinks[1]))
            && (data.snsLinks.size() < 3 || isValidSnsLink(data.snsLinks[2]))
            && (data.snsLinks.size() < 4 || isValidSnsLink(data.snsLinks[3]))
            && (data.snsLinks.size() < 5 || isValidSnsLink(data.snsLinks[4]))
            && (data.snsLinks.size() < 6 || isValidSnsLink(data.snsLinks[5]))
            && (data.snsLinks.size() < 7 || isValidSnsLink(data.snsLinks[6]))
            && (data.snsLinks.size() < 8 || isValidSnsLink(data.snsLinks[7]))
            && (data.snsLinks.size() < 9 || isValidSnsLink(data.snsLinks[8]))
            && (data.snsLinks.size() < 10 || isValidSnsLink(data.snsLinks[9]))))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // packages/data/firebase/schemas/firestore/profile_exchange.schema.json と
    // ProfileExchange.noteMaxLength (200) に合わせる。
    function isValidExchangeNote(data) {
      return !('note' in data) || data.note == null
        || (data.note is string && data.note.size() <= 200);
    }

    // プロフィール交換の履歴。読み取った側が自分のサブコレクションに作成し、
    // 相手側は Cloud Functions のトリガーがミラーする（ここでは作成できない）。
    match /users/{uid}/exchanges/{otherUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && otherUid != uid
        && request.resource.data.keys().hasOnly(['createdAt', 'origin', 'token', 'note'])
        && request.resource.data.origin == 'scan'
        && request.resource.data.token is string
        && request.resource.data.createdAt == request.time
        && isValidExchangeNote(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
        && isValidExchangeNote(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /staffMembers/{staffMemberId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /timelineEvents/{timelineEventId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    // クイズ大会は全体がログイン必須。閲覧も参加も実アカウントのサインインを
    // 求め、記録は常に本人の uid に紐づける。
    match /quizEvents/{eventId} {
      // 非公開（draft）のイベントは運営のみ閲覧できる。
      // 参加者アプリの一覧クエリは isPublic == true の等価条件で絞り込み、
      // list はその条件をクエリから証明できる（get は実ドキュメントで評価）。
      allow get, list: if hasAdminAccess()
        || (signedInWithAccount()
            && (resource.data.status != 'draft' || resource.data.isPublic == true));
      allow write: if hasAdminAccess();

      // 現地受付コード（運営のみ）。参加登録ルールが get() で参照する。
      match /secret/{secretId} {
        allow read, write: if hasAdminAccess();
      }

      // 参加登録時の受付コード申告。参加者ドキュメント作成に先立って本人が
      // 書き込み、コードの一致はこの時点でルールが検証する。
      // 読み取りは参加者には許可しない（コードの漏洩防止）。
      match /entryClaims/{uid} {
        allow read: if hasAdminAccess();
        // 受付中のみ・本人のみ・掲示中の受付コードと一致する場合のみ書ける。
        // 誤コードの再試行で上書きできるよう create / update とも許可する。
        allow create, update: if signedInWithAccount()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/quizEvents/$(eventId)).data.status == 'registration'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string
          && request.resource.data.code
             == get(/databases/$(database)/documents/quizEvents/$(eventId)/secret/entry).data.code;
        allow delete: if hasAdminAccess();
      }

      // 参加者とログインアカウントの紐づけ。メールアドレスのように本人と運営
      // にしか見せない情報を持つため、サインイン済みなら誰でも読める
      // participants とは別のコレクションに分けて保存する。
      match /participantAccounts/{uid} {
        allow get: if hasAdminAccess()
          || (signedInWithAccount() && request.auth.uid == uid);
        allow list: if hasAdminAccess();
        // 本人のみ・ID トークンの内容と一致する場合だけ書ける。他人になりすま
        // した紐づけや、偽のメールアドレスの申告を防ぐ。
        allow create, update: if signedInWithAccount()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['uid', 'email', 'accountName', 'photoUrl', 'signInProvider', 'linkedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.get('email', null)
          && request.resource.data.signInProvider == request.auth.token.firebase.sign_in_provider
          && request.resource.data.linkedAt == request.time;
        allow delete: if hasAdminAccess();
      }

      match /participants/{uid} {
        // 参加人数の表示とチーム編成のため、サインイン済みの参加者は一覧を
        // 読める。ここにはニックネームしか置かない。
        allow read: if hasAdminAccess() || signedInWithAccount();
        // 受付中のみ・本人のみ・受付コード検証済み（entryClaims が存在 = コード
        // 一致時のみ作成できる）・アカウント紐づけ済みの場合に登録できる。
        allow create: if signedInWithAccount()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/quizEvents/$(eventId)).data.status == 'registration'
          && request.resource.data.keys().hasOnly(['displayName', 'registeredAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 20
          && request.resource.data.registeredAt == request.time
          && exists(/databases/$(database)/documents/quizEvents/$(eventId)/entryClaims/$(uid))
          && exists(/databases/$(database)/documents/quizEvents/$(eventId)/participantAccounts/$(uid));
        allow update, delete: if hasAdminAccess();
      }

      match /teams/{teamId} {
        allow read: if hasAdminAccess() || signedInWithAccount();
        allow write: if hasAdminAccess();
      }

      match /questions/{questionId} {
        // draft の問題（未出題の問題文・選択肢）は参加者から見えない。
        allow get: if hasAdminAccess()
          || (signedInWithAccount() && resource.data.status != 'draft');
        allow list: if hasAdminAccess();
        allow write: if hasAdminAccess();

        match /secret/{secretId} {
          allow read, write: if hasAdminAccess();
        }
      }

      match /answers/{answerId} {
        // 自チームの回答のみ読める（他チームの回答の覗き見防止）。
        allow get: if hasAdminAccess()
          || (signedInWithAccount()
              && request.auth.uid in get(/databases/$(database)/documents/quizEvents/$(eventId)/teams/$(resource.data.teamId)).data.memberUids);
        allow list: if hasAdminAccess();
        // 作成・削除は運営のみ（出題時に全チーム分を事前作成する）。
        allow create, delete: if hasAdminAccess();
        // 参加者は自チームの回答の選択のみ変更できる。isCorrect 等は書けない。
        allow update: if hasAdminAccess()
          || (signedInWithAccount()
              && request.auth.uid in get(/databases/$(database)/documents/quizEvents/$(eventId)/teams/$(resource.data.teamId)).data.memberUids
              && get(/databases/$(database)/documents/quizEvents/$(eventId)/questions/$(resource.data.questionId)).data.status == 'open'
              && request.time < get(/databases/$(database)/documents/quizEvents/$(eventId)/questions/$(resource.data.questionId)).data.closesAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedOptionIndex', 'answeredBy', 'submittedAt'])
              && request.resource.data.selectedOptionIndex is int
              && request.resource.data.selectedOptionIndex >= 0
              && request.resource.data.selectedOptionIndex < get(/databases/$(database)/documents/quizEvents/$(eventId)/questions/$(resource.data.questionId)).data.options.size()
              && request.resource.data.answeredBy == request.auth.uid
              && request.resource.data.submittedAt == request.time);
      }
    }

    // 写真の相手の分類と SNS 投稿 URL を自己申告で登録する。1人1件。
    // プロフィールの公開範囲とは分け、本人だけが参照・変更できる。
    // 登録には匿名認証ではなくアカウントでのサインインが必要。
    match /snsPostRegistrations/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['url', 'companion', 'updatedAt'])
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && request.resource.data.url.matches('^https?://[^/?#\\s@]+[.][^/?#\\s@]+/[^?#\\s][^\\s]*$')
        && request.resource.data.companion in ['staff', 'speaker', 'sponsor', 'firstTime', 'differentCountry']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // 応援 LT の共通認証コード（current）と全体の失敗回数（attempts）。
    // 管理者も callable 経由で発行・再発行する。
    // 参加者に read を許可するとコードによる参加確認が成立しなくなる。
    match /supportLtSettings/{settingId} {
      allow read: if hasAdminAccess();
      allow write: if false;
    }

    // 本人は登録済み状態を get できる。参加者一覧・人数の取得は管理者のみ。
    // 登録・削除は認証コード検証と Auth 削除トリガーが Admin SDK で行う。
    match /supportLtRegistrations/{uid} {
      allow get: if isOwner(uid) || hasAdminAccess();
      allow list: if hasAdminAccess();
      allow write: if false;
    }

    // registerSupportLt の総当たり対策。本人・管理者とも直接変更できない。
    match /supportLtRegistrationAttempts/{uid} {
      allow read, write: if false;
    }

    // 6桁コードのフォールバック交換で使う短命ドキュメント。issueExchangeCode /
    // redeemExchangeCode コールが Admin SDK 経由で読み書きする。read を許すと
    // 総当たりでコードを引き当てられるため、クライアントからは read/write とも
    // 一切許可しない。
    match /exchangeCodes/{code} {
      allow read, write: if false;
    }

    // redeemExchangeCode の失敗試行回数（ドキュメント ID は呼び出し元 uid）。
    // 同様に Function からのみ読み書きする。
    match /exchangeCodeAttempts/{uid} {
      allow read, write: if false;
    }

    // 集計値。website からの未認証 read を想定して公開し、更新は
    // Cloud Functions トリガーのみに限定する。
    match /counters/{counterId} {
      allow read: if true;
      allow write: if false;
    }

    // 未定義のパスを明示的に拒否（多層防御）。
    // Firestore はデフォルトで拒否するが、コレクション追加時の取りこぼしを防ぐため明示する。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
